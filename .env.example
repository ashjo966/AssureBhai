GEMINI_API_KEY=your_gemini_api_key_here
NODE_ENV=development
PORT=3000

# PostgreSQL Database Connection URL (e.g. Railway PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/assurebhai

# Secret Admin Key for accessing /feedback?key=... admin dashboard
FEEDBACK_ADMIN_KEY=your_secret_admin_key_here

# Optional: GitHub sync for feedback (enables direct commits to assurebhai_feedback.xlsx in GitHub repo)
# GITHUB_TOKEN=your_github_personal_access_token_here
# GITHUB_REPO_OWNER=ashjo966
# GITHUB_REPO_NAME=AssureBhai
# GITHUB_REPO_BRANCH=main
